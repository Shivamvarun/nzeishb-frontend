{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist/nzeishb-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nzeishb.api.typsadev.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
